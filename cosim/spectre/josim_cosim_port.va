    rc = josim_dpi_set_input(h, 2, V(p2, n2));
    rc = josim_dpi_set_input(h, 3, V(p3, n3));
    rc = josim_dpi_eval(h, $abstime);

    ih0 = josim_dpi_get_hist(h, 0); g0 = josim_dpi_get_jacobian(h, 0);
    ih1 = josim_dpi_get_hist(h, 1); g1 = josim_dpi_get_jacobian(h, 1);
    ih2 = josim_dpi_get_hist(h, 2); g2 = josim_dpi_get_jacobian(h, 2);
    ih3 = josim_dpi_get_hist(h, 3); g3 = josim_dpi_get_jacobian(h, 3);

    if (analysis("dc") || $abstime <= 0.0) begin
      I(p0, n0) <+ ih0 + (g0 + gmin_dc) * V(p0, n0);
      I(p1, n1) <+ ih1 + (g1 + gmin_dc) * V(p1, n1);
      I(p2, n2) <+ ih2 + (g2 + gmin_dc) * V(p2, n2);
      I(p3, n3) <+ ih3 + (g3 + gmin_dc) * V(p3, n3);
    end else begin
      I(p0, n0) <+ ih0 + g0 * V(p0, n0);
      I(p1, n1) <+ ih1 + g1 * V(p1, n1);
      I(p2, n2) <+ ih2 + g2 * V(p2, n2);
      I(p3, n3) <+ ih3 + g3 * V(p3, n3);
    end

    if (maxstep_mult > 0.0 && dt_j > 0.0) begin
      $bound_step(maxstep_mult * dt_j);
    end
  end
endmodule


// -----------------------------------------------------------------------------
// 6. Five-Port Norton / Branin Wave Boundary (e.g., clocked 2-in 1-out gate + Bias)
// -----------------------------------------------------------------------------
module josim_cosim_port_5p(p0, n0, p1, n1, p2, n2, p3, n3, p4, n4);
  inout p0, n0, p1, n1, p2, n2, p3, n3, p4, n4;
  electrical p0, n0, p1, n1, p2, n2, p3, n3, p4, n4;

  parameter string netlist      = "";
  parameter string port_nodes   = "1,2,3,4,5";
  parameter string port_modes   = "0,0,0,0,0";
  parameter string endpoint     = "";
  parameter string out_csv      = "";
  parameter string events       = "";
  parameter real   maxstep_mult = 0.0;
  parameter real   gmin_dc      = 1e-12;

  import `JOSIM_DPI_IMPORT function integer josim_dpi_open(
    input string netlist_path,
    input string port_nodes_csv,
    input string port_modes_csv,
    input string ep
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_set_output(
    input integer h,
    input string  out_csv_path,
    input string  events_csv_path
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_tstep(
    input integer h
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_set_input(
    input integer h,
    input integer port_idx,
    input real    val
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_eval(
    input integer h,
    input real    t_s
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_get_hist(
    input integer h,
    input integer port_idx
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_get_jacobian(
    input integer h,
    input integer port_idx
  );

  integer h, rc;
  real    dt_j;
  real    ih0, g0, ih1, g1, ih2, g2, ih3, g3, ih4, g4;

  analog begin
    @(initial_step) begin
      h    = josim_dpi_open(netlist, port_nodes, port_modes, endpoint);
      rc   = josim_dpi_set_output(h, out_csv, events);
      dt_j = josim_dpi_tstep(h);
    end

    rc = josim_dpi_set_input(h, 0, V(p0, n0));
    rc = josim_dpi_set_input(h, 1, V(p1, n1));
    rc = josim_dpi_set_input(h, 2, V(p2, n2));
    rc = josim_dpi_set_input(h, 3, V(p3, n3));
    rc = josim_dpi_set_input(h, 4, V(p4, n4));
    rc = josim_dpi_eval(h, $abstime);

    ih0 = josim_dpi_get_hist(h, 0); g0 = josim_dpi_get_jacobian(h, 0);
    ih1 = josim_dpi_get_hist(h, 1); g1 = josim_dpi_get_jacobian(h, 1);
    ih2 = josim_dpi_get_hist(h, 2); g2 = josim_dpi_get_jacobian(h, 2);
    ih3 = josim_dpi_get_hist(h, 3); g3 = josim_dpi_get_jacobian(h, 3);
    ih4 = josim_dpi_get_hist(h, 4); g4 = josim_dpi_get_jacobian(h, 4);

    if (analysis("dc") || $abstime <= 0.0) begin
      I(p0, n0) <+ ih0 + (g0 + gmin_dc) * V(p0, n0);
      I(p1, n1) <+ ih1 + (g1 + gmin_dc) * V(p1, n1);
      I(p2, n2) <+ ih2 + (g2 + gmin_dc) * V(p2, n2);
      I(p3, n3) <+ ih3 + (g3 + gmin_dc) * V(p3, n3);
      I(p4, n4) <+ ih4 + (g4 + gmin_dc) * V(p4, n4);
    end else begin
      I(p0, n0) <+ ih0 + g0 * V(p0, n0);
      I(p1, n1) <+ ih1 + g1 * V(p1, n1);
      I(p2, n2) <+ ih2 + g2 * V(p2, n2);
      I(p3, n3) <+ ih3 + g3 * V(p3, n3);
      I(p4, n4) <+ ih4 + g4 * V(p4, n4);
    end

    if (maxstep_mult > 0.0 && dt_j > 0.0) begin
      $bound_step(maxstep_mult * dt_j);
    end
  end
endmodule


// -----------------------------------------------------------------------------
// 7. Six-Port Norton / Branin Wave Boundary
// -----------------------------------------------------------------------------
module josim_cosim_port_6p(p0, n0, p1, n1, p2, n2, p3, n3, p4, n4, p5, n5);
  inout p0, n0, p1, n1, p2, n2, p3, n3, p4, n4, p5, n5;
  electrical p0, n0, p1, n1, p2, n2, p3, n3, p4, n4, p5, n5;

  parameter string netlist      = "";
  parameter string port_nodes   = "1,2,3,4,5,6";
  parameter string port_modes   = "0,0,0,0,0,0";
  parameter string endpoint     = "";
  parameter string out_csv      = "";
  parameter string events       = "";
  parameter real   maxstep_mult = 0.0;
  parameter real   gmin_dc      = 1e-12;

  import `JOSIM_DPI_IMPORT function integer josim_dpi_open(
    input string netlist_path,
    input string port_nodes_csv,
    input string port_modes_csv,
    input string ep
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_set_output(
    input integer h,
    input string  out_csv_path,
    input string  events_csv_path
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_tstep(
    input integer h
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_set_input(
    input integer h,
    input integer port_idx,
    input real    val
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_eval(
    input integer h,
    input real    t_s
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_get_hist(
    input integer h,
    input integer port_idx
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_get_jacobian(
    input integer h,
    input integer port_idx
  );

  integer h, rc;
  real    dt_j;
  real    ih0, g0, ih1, g1, ih2, g2, ih3, g3, ih4, g4, ih5, g5;

  analog begin
    @(initial_step) begin
      h    = josim_dpi_open(netlist, port_nodes, port_modes, endpoint);
      rc   = josim_dpi_set_output(h, out_csv, events);
      dt_j = josim_dpi_tstep(h);
    end

    rc = josim_dpi_set_input(h, 0, V(p0, n0));
    rc = josim_dpi_set_input(h, 1, V(p1, n1));
    rc = josim_dpi_set_input(h, 2, V(p2, n2));
    rc = josim_dpi_set_input(h, 3, V(p3, n3));
    rc = josim_dpi_set_input(h, 4, V(p4, n4));
    rc = josim_dpi_set_input(h, 5, V(p5, n5));
    rc = josim_dpi_eval(h, $abstime);

    ih0 = josim_dpi_get_hist(h, 0); g0 = josim_dpi_get_jacobian(h, 0);
    ih1 = josim_dpi_get_hist(h, 1); g1 = josim_dpi_get_jacobian(h, 1);
    ih2 = josim_dpi_get_hist(h, 2); g2 = josim_dpi_get_jacobian(h, 2);
    ih3 = josim_dpi_get_hist(h, 3); g3 = josim_dpi_get_jacobian(h, 3);
    ih4 = josim_dpi_get_hist(h, 4); g4 = josim_dpi_get_jacobian(h, 4);
    ih5 = josim_dpi_get_hist(h, 5); g5 = josim_dpi_get_jacobian(h, 5);

    if (analysis("dc") || $abstime <= 0.0) begin
      I(p0, n0) <+ ih0 + (g0 + gmin_dc) * V(p0, n0);
      I(p1, n1) <+ ih1 + (g1 + gmin_dc) * V(p1, n1);
      I(p2, n2) <+ ih2 + (g2 + gmin_dc) * V(p2, n2);
      I(p3, n3) <+ ih3 + (g3 + gmin_dc) * V(p3, n3);
      I(p4, n4) <+ ih4 + (g4 + gmin_dc) * V(p4, n4);
      I(p5, n5) <+ ih5 + (g5 + gmin_dc) * V(p5, n5);
    end else begin
      I(p0, n0) <+ ih0 + g0 * V(p0, n0);
      I(p1, n1) <+ ih1 + g1 * V(p1, n1);
      I(p2, n2) <+ ih2 + g2 * V(p2, n2);
      I(p3, n3) <+ ih3 + g3 * V(p3, n3);
      I(p4, n4) <+ ih4 + g4 * V(p4, n4);
      I(p5, n5) <+ ih5 + g5 * V(p5, n5);
    end

    if (maxstep_mult > 0.0 && dt_j > 0.0) begin
      $bound_step(maxstep_mult * dt_j);
    end
  end
endmodule


// -----------------------------------------------------------------------------
// 8. Eight-Port Norton / Branin Wave Boundary
// -----------------------------------------------------------------------------
module josim_cosim_port_8p(p0, n0, p1, n1, p2, n2, p3, n3, p4, n4, p5, n5, p6, n6, p7, n7);
  inout p0, n0, p1, n1, p2, n2, p3, n3, p4, n4, p5, n5, p6, n6, p7, n7;
  electrical p0, n0, p1, n1, p2, n2, p3, n3, p4, n4, p5, n5, p6, n6, p7, n7;

  parameter string netlist      = "";
  parameter string port_nodes   = "1,2,3,4,5,6,7,8";
  parameter string port_modes   = "0,0,0,0,0,0,0,0";
  parameter string endpoint     = "";
  parameter string out_csv      = "";
  parameter string events       = "";
  parameter real   maxstep_mult = 0.0;
  parameter real   gmin_dc      = 1e-12;

  import `JOSIM_DPI_IMPORT function integer josim_dpi_open(
    input string netlist_path,
    input string port_nodes_csv,
    input string port_modes_csv,
    input string ep
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_set_output(
    input integer h,
    input string  out_csv_path,
    input string  events_csv_path
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_tstep(
    input integer h
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_set_input(
    input integer h,
    input integer port_idx,
    input real    val
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_eval(
    input integer h,
    input real    t_s
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_get_hist(
    input integer h,
    input integer port_idx
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_get_jacobian(
    input integer h,
    input integer port_idx
  );

  integer h, rc;
  real    dt_j;
  real    ih0, g0, ih1, g1, ih2, g2, ih3, g3, ih4, g4, ih5, g5, ih6, g6, ih7, g7;

  analog begin
    @(initial_step) begin
      h    = josim_dpi_open(netlist, port_nodes, port_modes, endpoint);
      rc   = josim_dpi_set_output(h, out_csv, events);
      dt_j = josim_dpi_tstep(h);
    end

    rc = josim_dpi_set_input(h, 0, V(p0, n0));
    rc = josim_dpi_set_input(h, 1, V(p1, n1));
    rc = josim_dpi_set_input(h, 2, V(p2, n2));
    rc = josim_dpi_set_input(h, 3, V(p3, n3));
    rc = josim_dpi_set_input(h, 4, V(p4, n4));
    rc = josim_dpi_set_input(h, 5, V(p5, n5));
    rc = josim_dpi_set_input(h, 6, V(p6, n6));
    rc = josim_dpi_set_input(h, 7, V(p7, n7));
    rc = josim_dpi_eval(h, $abstime);

    ih0 = josim_dpi_get_hist(h, 0); g0 = josim_dpi_get_jacobian(h, 0);
    ih1 = josim_dpi_get_hist(h, 1); g1 = josim_dpi_get_jacobian(h, 1);
    ih2 = josim_dpi_get_hist(h, 2); g2 = josim_dpi_get_jacobian(h, 2);
    ih3 = josim_dpi_get_hist(h, 3); g3 = josim_dpi_get_jacobian(h, 3);
    ih4 = josim_dpi_get_hist(h, 4); g4 = josim_dpi_get_jacobian(h, 4);
    ih5 = josim_dpi_get_hist(h, 5); g5 = josim_dpi_get_jacobian(h, 5);
    ih6 = josim_dpi_get_hist(h, 6); g6 = josim_dpi_get_jacobian(h, 6);
    ih7 = josim_dpi_get_hist(h, 7); g7 = josim_dpi_get_jacobian(h, 7);

    if (analysis("dc") || $abstime <= 0.0) begin
      I(p0, n0) <+ ih0 + (g0 + gmin_dc) * V(p0, n0);
      I(p1, n1) <+ ih1 + (g1 + gmin_dc) * V(p1, n1);
      I(p2, n2) <+ ih2 + (g2 + gmin_dc) * V(p2, n2);
      I(p3, n3) <+ ih3 + (g3 + gmin_dc) * V(p3, n3);
      I(p4, n4) <+ ih4 + (g4 + gmin_dc) * V(p4, n4);
      I(p5, n5) <+ ih5 + (g5 + gmin_dc) * V(p5, n5);
      I(p6, n6) <+ ih6 + (g6 + gmin_dc) * V(p6, n6);
      I(p7, n7) <+ ih7 + (g7 + gmin_dc) * V(p7, n7);
    end else begin
      I(p0, n0) <+ ih0 + g0 * V(p0, n0);
      I(p1, n1) <+ ih1 + g1 * V(p1, n1);
      I(p2, n2) <+ ih2 + g2 * V(p2, n2);
      I(p3, n3) <+ ih3 + g3 * V(p3, n3);
      I(p4, n4) <+ ih4 + g4 * V(p4, n4);
      I(p5, n5) <+ ih5 + g5 * V(p5, n5);
      I(p6, n6) <+ ih6 + g6 * V(p6, n6);
      I(p7, n7) <+ ih7 + g7 * V(p7, n7);
    end

    if (maxstep_mult > 0.0 && dt_j > 0.0) begin
      $bound_step(maxstep_mult * dt_j);
    end
  end
endmodule

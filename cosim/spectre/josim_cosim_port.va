    input integer h,
    input integer port_idx,
    input real    val
  );
  import `JOSIM_DPI_IMPORT function integer josim_dpi_eval(
    input integer h,
    input real    t_s
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_get_hist(
    input integer h,
    input integer port_idx
  );
  import `JOSIM_DPI_IMPORT function real josim_dpi_get_jacobian(
    input integer h,
    input integer port_idx
  );

  integer h, rc;
  real    dt_j;
  real    ih0, g0, ih1, g1, ih2, g2, ih3, g3;

  analog begin
    @(initial_step) begin
      h    = josim_dpi_open(netlist, port_nodes, port_modes, endpoint);
      rc   = josim_dpi_set_output(h, out_csv, events);
      dt_j = josim_dpi_tstep(h);
    end

    rc = josim_dpi_set_input(h, 0, V(p0, n0));
